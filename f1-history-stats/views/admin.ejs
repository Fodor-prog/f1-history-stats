<%- include("partials/header", {
    title: title,
    activePage: "admin"
}) %>

<main>

    <!-- ========================================
         ADMIN FŐOLDAL FEJLÉCE
    ======================================== -->

    <section class="page-hero">

        <div class="container page-hero-content">

            <p class="section-kicker">
                F1 HISTORY STATS
            </p>

            <p class="page-breadcrumb">
                <a href="/">Főoldal</a>
                <span>/</span>
                Adminisztráció
            </p>

            <h1>
                ADMIN
                <span>FELÜLET.</span>
            </h1>

            <p class="page-description">
                Üdvözlünk az F1 History Stats
                adminisztrációs felületén!
                Itt kezelheted az adatbázisban
                tárolt Forma–1-es adatokat.
            </p>

            <div class="page-hero-meta">
                <span class="meta-marker"></span>
                ADMINISZTRÁTORI HOZZÁFÉRÉS
            </div>

        </div>

    </section>

    <!-- ========================================
         ADMINISZTRÁCIÓS FUNKCIÓK
    ======================================== -->

    <section class="section listing-section">

        <div class="container">

            <div class="section-heading">

                <div>

                    <p class="section-kicker">
                        ADATBÁZIS-KEZELÉS
                    </p>

                    <h2>
                        ADMINISZTRÁCIÓS
                        <span>FUNKCIÓK.</span>
                    </h2>

                </div>

                <p class="section-lead">
                    Válaszd ki a használni kívánt
                    adminisztrációs funkciót!
                </p>

            </div>

            <!-- ========================================
                 NAGYDÍJAK KEZELÉSE
            ======================================== -->

            <div
                class="races-panel"
                style="
                    padding: 32px;
                    margin-bottom: 24px;
                "
            >

                <p class="section-kicker">
                    01 / CRUD ADATKEZELÉS
                </p>

                <h3 style="
                    margin: 12px 0 16px;
                    font-size: 28px;
                ">
                    NAGYDÍJAK KEZELÉSE
                </h3>

                <p style="
                    margin-bottom: 24px;
                    max-width: 650px;
                ">
                    A MongoDB Atlas adatbázisban
                    tárolt nagydíjak megtekintése,
                    új nagydíjak létrehozása,
                    meglévő rekordok szerkesztése
                    és törlése.
                </p>

                <div style="
                    display: flex;
                    flex-wrap: wrap;
                    gap: 14px;
                ">

                    <a
                        href="/admin/nagydijak"
                        class="btn btn-primary"
                    >
                        Nagydíjak kezelése ↗
                    </a>

                    <a
                        href="/admin/nagydijak/uj"
                        class="btn btn-outline"
                    >
                        + Új nagydíj
                    </a>

                </div>

            </div>

            <!-- ========================================
                 TOVÁBBI ELÉRHETŐ OLDALAK
            ======================================== -->

            <div
                class="races-panel"
                style="
                    padding: 32px;
                    margin-bottom: 24px;
                "
            >

                <p class="section-kicker">
                    02 / FELHASZNÁLÓI TARTALOM
                </p>

                <h3 style="
                    margin: 12px 0 16px;
                    font-size: 28px;
                ">
                    BEÉRKEZETT ÜZENETEK
                </h3>

                <p style="
                    margin-bottom: 24px;
                    max-width: 650px;
                ">
                    Tekintsd meg a kapcsolatfelvételi
                    űrlapon keresztül beküldött üzeneteket,
                    időrendben, a legújabbakkal kezdve.
                </p>

                <a
                    href="/messages"
                    class="btn btn-outline"
                >
                    Üzenetek megtekintése ↗
                </a>

            </div>

            <!-- ========================================
                 NYILVÁNOS ADATBÁZIS
            ======================================== -->

            <div
                class="races-panel"
                style="padding: 32px;"
            >

                <p class="section-kicker">
                    03 / NYILVÁNOS FELÜLET
                </p>

                <h3 style="
                    margin: 12px 0 16px;
                    font-size: 28px;
                ">
                    ADATBÁZIS MEGTEKINTÉSE
                </h3>

                <p style="
                    margin-bottom: 24px;
                    max-width: 650px;
                ">
                    A nagydíjak, pilóták és
                    versenyeredmények nyilvános
                    adatbázisának böngészése.
                </p>

                <div style="
                    display: flex;
                    flex-wrap: wrap;
                    gap: 14px;
                ">

                    <a
                        href="/nagydijak"
                        class="btn btn-outline"
                    >
                        Nagydíjak
                    </a>

                    <a
                        href="/pilotak"
                        class="btn btn-outline"
                    >
                        Pilóták
                    </a>

                    <a
                        href="/eredmenyek"
                        class="btn btn-outline"
                    >
                        Eredmények
                    </a>

                </div>

            </div>

            <!-- ========================================
                 ADMIN TÁJÉKOZTATÁS
            ======================================== -->

            <p
                class="data-note"
                style="margin-top: 28px;"
            >
                Az adminisztrációs adatkezelés
                kizárólag admin jogosultsággal érhető el.
                A módosítások közvetlenül a
                MongoDB Atlas adatbázisában történnek.
            </p>

            <!-- VISSZA -->

            <div style="margin-top: 30px;">

                <a
                    href="/"
                    class="reset-link"
                >
                    ← Vissza a főoldalra
                </a>

            </div>

        </div>

    </section>

</main>

<%- include("partials/footer") %>