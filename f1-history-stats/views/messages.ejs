<%- include("partials/header", {
    title: title,
    activePage: "messages"
}) %>

<main>

    <!-- OLDAL FEJLÉCE -->

    <section class="page-hero">
        <div class="container page-hero-content">

            <div class="eyebrow">
                <span class="live-dot"></span>
                F1 HISTORY STATS
            </div>

            <p class="page-breadcrumb">
                <a href="/">Főoldal</a>
                <span>/</span>
                Beérkezett üzenetek
            </p>

            <h1>
                BEÉRKEZETT
                <span>ÜZENETEK.</span>
            </h1>

            <p class="page-description">
                Az F1 History Stats kapcsolatfelvételi
                űrlapján keresztül beküldött üzenetek.
                Az üzeneteket kizárólag bejelentkezett
                felhasználók tekinthetik meg.
            </p>

            <div class="page-hero-meta">
                <span class="meta-marker"></span>
                VÉDETT FELHASZNÁLÓI TARTALOM
            </div>

        </div>
    </section>

    <!-- ÜZENETEK -->

    <section class="section listing-section">
        <div class="container">

            <div class="section-heading">

                <div>
                    <p class="section-kicker">
                        KAPCSOLATFELVÉTEL
                    </p>

                    <h2>
                        ÜZENETEK
                        <span>LISTÁJA.</span>
                    </h2>
                </div>

                <p class="section-lead">
                    Az üzenetek a beküldés időpontja
                    szerint, legújabbal kezdve jelennek meg.
                </p>

            </div>

            <!-- TALÁLATOK SZÁMA -->

            <div class="results-summary">

                <div>
                    <span class="results-label">
                        BEÉRKEZETT ÜZENETEK
                    </span>

                    <strong class="results-number">
                        <%= messages.length.toLocaleString("hu-HU") %>
                    </strong>
                </div>

                <p>
                    Legújabb üzenetek elöl
                </p>

            </div>

            <!-- ÜZENETEK TÁBLÁZATA -->

            <div
                class="races-panel"
                style="
                    overflow-x: auto;
                    background-color: #151820;
                    border: 1px solid #303541;
                "
            >

                <% if (messages.length > 0) { %>

                    <table
                        class="messages-table"
                        style="
                            width: 100%;
                            border-collapse: collapse;
                            border-spacing: 0;
                            text-align: left;
                            background-color: #151820 !important;
                            color: #f5f5f5 !important;
                            margin: 0;
                        "
                    >

                        <thead>
                            <tr
                                style="
                                    background-color: #20242f !important;
                                    border-bottom: 2px solid #e10600;
                                "
                            >

                                <th
                                    scope="col"
                                    style="
                                        padding: 20px 16px;
                                        width: 65px;
                                        color: #ffffff !important;
                                        background-color: #20242f !important;
                                        font-weight: 700;
                                        text-align: left;
                                    "
                                >
                                    #
                                </th>

                                <th
                                    scope="col"
                                    style="
                                        padding: 20px 16px;
                                        min-width: 180px;
                                        color: #ffffff !important;
                                        background-color: #20242f !important;
                                        font-weight: 700;
                                        text-align: left;
                                    "
                                >
                                    KÜLDŐ
                                </th>

                                <th
                                    scope="col"
                                    style="
                                        padding: 20px 16px;
                                        min-width: 280px;
                                        color: #ffffff !important;
                                        background-color: #20242f !important;
                                        font-weight: 700;
                                        text-align: left;
                                    "
                                >
                                    ÜZENET
                                </th>

                                <th
                                    scope="col"
                                    style="
                                        padding: 20px 16px;
                                        min-width: 170px;
                                        color: #ffffff !important;
                                        background-color: #20242f !important;
                                        font-weight: 700;
                                        text-align: left;
                                    "
                                >
                                    BEKÜLDÉS IDEJE
                                </th>

                            </tr>
                        </thead>

                        <tbody>

                            <% messages.forEach((item, index) => { %>

                                <tr
                                    style="
                                        background-color: #191d27 !important;
                                        border-bottom: 1px solid #353a46;
                                    "
                                >

                                    <!-- SORSZÁM -->

                                    <td
                                        style="
                                            padding: 22px 16px;
                                            vertical-align: top;
                                            background-color: #191d27 !important;
                                            color: #ffffff !important;
                                            text-align: left;
                                        "
                                    >

                                        <span
                                            class="race-index"
                                            style="
                                                color: #e10600 !important;
                                                font-weight: 800;
                                                font-size: 20px;
                                            "
                                        >
                                            <%= String(index + 1).padStart(2, "0") %>
                                        </span>

                                    </td>

                                    <!-- KÜLDŐ -->

                                    <td
                                        style="
                                            padding: 22px 16px;
                                            vertical-align: top;
                                            background-color: #191d27 !important;
                                            color: #ffffff !important;
                                            text-align: left;
                                        "
                                    >

                                        <strong
                                            style="
                                                display: block;
                                                color: #ffffff !important;
                                                font-size: 15px;
                                                font-weight: 700;
                                                margin-bottom: 6px;
                                            "
                                        >
                                            <%= item.name %>
                                        </strong>

                                        <small
                                            style="
                                                display: block;
                                                color: #b9c7dd !important;
                                                font-size: 13px;
                                                overflow-wrap: anywhere;
                                                line-height: 1.6;
                                            "
                                        >
                                            <%= item.email %>
                                        </small>

                                    </td>

                                    <!-- ÜZENET -->

                                    <td
                                        style="
                                            padding: 22px 16px;
                                            vertical-align: top;
                                            background-color: #191d27 !important;
                                            color: #ffffff !important;
                                            text-align: left;
                                        "
                                    >

                                        <strong
                                            style="
                                                display: block;
                                                color: #ffffff !important;
                                                font-size: 15px;
                                                font-weight: 700;
                                                margin-bottom: 10px;
                                            "
                                        >
                                            <%= item.subject %>
                                        </strong>

                                        <p
                                            style="
                                                color: #d5dbe5 !important;
                                                font-size: 14px;
                                                line-height: 1.7;
                                                white-space: pre-wrap;
                                                overflow-wrap: anywhere;
                                                margin: 0;
                                                padding: 0;
                                                text-align: left !important;
                                            "
                                        ><%= item.message %></p>

                                    </td>

                                    <!-- BEKÜLDÉS DÁTUMA -->

                                    <td
                                        style="
                                            padding: 22px 16px;
                                            vertical-align: top;
                                            background-color: #191d27 !important;
                                            color: #ffffff !important;
                                            text-align: left;
                                        "
                                    >

                                        <strong
                                            style="
                                                display: block;
                                                color: #ffffff !important;
                                                font-size: 14px;
                                                font-weight: 600;
                                                line-height: 1.6;
                                            "
                                        >
                                            <%= new Date(item.createdAt).toLocaleDateString("hu-HU", {
                                                timeZone: "Europe/Budapest",
                                                year: "numeric",
                                                month: "long",
                                                day: "numeric"
                                            }) %>
                                        </strong>

                                        <div
                                            style="
                                                color: #b9c7dd !important;
                                                font-size: 14px;
                                                margin-top: 6px;
                                            "
                                        >
                                            <%= new Date(item.createdAt).toLocaleTimeString("hu-HU", {
                                                timeZone: "Europe/Budapest",
                                                hour: "2-digit",
                                                minute: "2-digit"
                                            }) %>
                                        </div>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                <% } else { %>

                    <div
                        class="no-results"
                        style="
                            background-color: #191d27;
                            padding: 40px 24px;
                            text-align: center;
                        "
                    >

                        <h3 style="color: #ffffff !important;">
                            MÉG NINCS ÜZENET
                        </h3>

                        <p style="color: #d5dbe5 !important;">
                            Jelenleg nem érkezett
                            kapcsolatfelvételi üzenet.
                        </p>

                        <a href="/contact" class="btn btn-outline">
                            Kapcsolat oldal
                        </a>

                    </div>

                <% } %>

            </div>

            <!-- NAVIGÁCIÓ -->

            <div class="section-footer-action">

                <a href="/contact" class="btn btn-primary">
                    Kapcsolat oldal ↗
                </a>

                <a href="/user" class="btn btn-outline">
                    Vissza a profilhoz
                </a>

            </div>

        </div>
    </section>

</main>

<%- include("partials/footer") %>