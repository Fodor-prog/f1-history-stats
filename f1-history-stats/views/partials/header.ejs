
<!DOCTYPE html>
<html lang="hu">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>

    <meta name="description"
          content="F1 History Stats – Forma–1 történelmi nagydíjak, pilóták és versenyeredmények adatbázisa.">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- ==================================
         KÖZÖS FEJLÉC
    ================================== -->

    <header class="site-header">

        <div class="container header-inner">

            <!-- LOGÓ -->

            <a href="/"
               class="logo"
               aria-label="F1 History Stats főoldal">

                <span class="logo-symbol">
                    F1<span>.</span>
                </span>

                <span class="logo-name">
                    HISTORY<span>STATS</span>
                </span>

            </a>

            <!-- ==================================
                 FŐ NAVIGÁCIÓ
            ================================== -->

            <nav class="main-nav" aria-label="Fő navigáció">

                <!-- FŐOLDAL -->

                <a href="/"
                   class="<%= activePage === 'home' ? 'nav-active' : '' %>"
                   <% if (activePage === "home") { %>
                       aria-current="page"
                   <% } %>>
                    Főoldal
                </a>

                <!-- NAGYDÍJAK -->

                <a href="/nagydijak"
                   class="<%= activePage === 'nagydijak' ? 'nav-active' : '' %>"
                   <% if (activePage === "nagydijak") { %>
                       aria-current="page"
                   <% } %>>
                    Nagydíjak
                </a>

                <!-- PILÓTÁK -->

                <a href="/pilotak"
                   class="<%= activePage === 'pilotak' ? 'nav-active' : '' %>"
                   <% if (activePage === "pilotak") { %>
                       aria-current="page"
                   <% } %>>
                    Pilóták
                </a>

                <!-- EREDMÉNYEK -->

                <a href="/eredmenyek"
                   class="<%= activePage === 'eredmenyek' ? 'nav-active' : '' %>"
                   <% if (activePage === "eredmenyek") { %>
                       aria-current="page"
                   <% } %>>
                    Eredmények
                </a>

                <!-- KAPCSOLAT: MINDENKINEK -->

                <a href="/contact"
                   class="<%= activePage === 'contact' ? 'nav-active' : '' %>"
                   <% if (activePage === "contact") { %>
                       aria-current="page"
                   <% } %>>
                    Kapcsolat
                </a>

                <!-- ==================================
                     VENDÉG NAVIGÁCIÓ
                ================================== -->

                <% if (!user) { %>

                    <a href="/register"
                       class="<%= activePage === 'register' ? 'nav-active' : '' %>">
                        Regisztráció
                    </a>

                    <a href="/login"
                       class="<%= activePage === 'login' ? 'nav-active' : '' %>">
                        Bejelentkezés
                    </a>

                <% } else { %>

                    <!-- ==================================
                         BEJELENTKEZETT FELHASZNÁLÓ
                    ================================== -->

                    <!-- ÜZENETEK:
                         CSAK BEJELENTKEZVE -->

                    <a href="/messages"
                       class="<%= activePage === 'messages' ? 'nav-active' : '' %>"
                       <% if (activePage === "messages") { %>
                           aria-current="page"
                       <% } %>>
                        Üzenetek
                    </a>

                    <!-- PROFIL -->

                    <a href="/user"
                       class="<%= activePage === 'user' ? 'nav-active' : '' %>"
                       <% if (activePage === "user") { %>
                           aria-current="page"
                       <% } %>>
                        Profil
                    </a>

                    <!-- ==================================
                         ADMIN NAVIGÁCIÓ
                    ================================== -->

                    <% if (user.role === "admin") { %>

                        <a href="/admin"
                           class="<%= activePage === 'admin' ? 'nav-active' : '' %>"
                           <% if (activePage === "admin") { %>
                               aria-current="page"
                           <% } %>>
                            Admin
                        </a>

                    <% } %>

                    <!-- KIJELENTKEZÉS -->

                    <a href="/logout">
                        Kijelentkezés
                    </a>

                <% } %>

            </nav>

            <!-- ==================================
                 JOBB OLDALI GOMB
            ================================== -->

            <% if (user) { %>

                <a href="/user" class="header-action">

                    <%= user.username %>

                    <span aria-hidden="true">
                        ↗
                    </span>

                </a>

            <% } else { %>

                <a href="/login" class="header-action">

                    Belépés

                    <span aria-hidden="true">
                        ↗
                    </span>

                </a>

            <% } %>

        </div>

    </header>
