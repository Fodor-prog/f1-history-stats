<!DOCTYPE html>
<html lang="hu">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <meta
        name="description"
        content="F1 History Stats – történelmi Forma–1-es nagydíjak, pilóták, eredmények és statisztikák."
    >

    <title><%= title %></title>

    <!-- ========================================
         HTML5 UP EDITORIAL ALAPSTÍLUS
    ======================================== -->

    <link
        rel="stylesheet"
        href="/editorial/assets/css/main.css"
    >

    <!-- ========================================
         MEGLÉVŐ F1 HISTORY STATS STÍLUS
    ======================================== -->

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <!-- ========================================
         EDITORIAL + F1 TESTRESZABÁS
    ======================================== -->

    <link
        rel="stylesheet"
        href="/css/editorial-custom.css"
    >

</head>

<body class="is-preload">

    <div id="wrapper">

        <!-- ====================================
             FŐ TARTALMI TERÜLET
        ==================================== -->

        <div id="main">

            <div class="inner">

                <!-- =================================
                     FEJLÉC
                ================================= -->

                <header id="header">

                    <a
                        href="/"
                        class="logo"
                        aria-label="F1 History Stats főoldal"
                    >
                        <strong>F1</strong>
                        HISTORY STATS
                    </a>

                    <div class="editorial-user-status">

                        <% if (user) { %>

                            <a href="/user">
                                <%= user.username %>
                            </a>

                            <% if (user.role === "admin") { %>

                                <span class="editorial-role">
                                    ADMIN
                                </span>

                            <% } %>

                        <% } else { %>

                            <a href="/login">
                                Bejelentkezés
                            </a>

                        <% } %>

                    </div>

                </header>

                <!-- =================================
                     OLDALAK TARTALMA
                ================================= -->